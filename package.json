{
    "name": "CensorBench",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "build:web": "turbo run build --filter=web",
        "start:web": "turbo run start --filter=web",
        "start": "turbo run start",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "cf:build": "turbo run cf:build",
        "cf:deploy": "turbo run cf:deploy",
        "check-types": "turbo run check-types"
    },
    "devDependencies": {
        "prettier": "^3.6.2",
        "turbo": "^2.5.8",
        "typescript": "5.9.2"
    },
    "engines": {
        "node": ">=18"
    },
    "packageManager": "bun@1.2.21",
    "workspaces": [
        "apps/*",
        "packages/*"
    ]
}
