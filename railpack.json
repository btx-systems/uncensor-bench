{
    "$schema": "https://schema.railpack.com",
    "steps": {
        "install": {
            "commands": ["pwd", "ls -la", "bun --version", "bun install"]
        },
        "build": {
            "inputs": [{ "step": "install" }],
            "commands": ["bun run build:web"]
        }
    },
    "deploy": {
        "startCommand": "bun run start:web"
    }
}
